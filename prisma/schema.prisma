// Schéma Prisma généré à partir de teleconsultation_database.sql
// Base cible : PostgreSQL
// Les noms SQL existants sont conservés grâce à @map et @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Specialty {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique(map: "uq_specialties_name") @db.VarChar(100)
  description String?   @db.Text
  status      Boolean   @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(0)

  doctors Doctor[]

  @@map("specialties")
}

model Patient {
  id          BigInt         @id @default(autoincrement())
  uuid        String         @unique(map: "uq_patients_uuid") @db.Char(36)
  firstName   String         @map("first_name") @db.VarChar(100)
  lastName    String         @map("last_name") @db.VarChar(100)
  email       String         @unique(map: "uq_patients_email") @db.VarChar(150)
  phone       String         @unique(map: "uq_patients_phone") @db.VarChar(30)
  password    String         @db.VarChar(255)
  dateOfBirth DateTime?      @map("date_of_birth") @db.Date
  gender      PatientGender?
  address     String?        @db.Text
  avatar      String?        @db.VarChar(500)
  status          PatientStatus  @default(pending)
  externalRef     String?        @map("external_ref") @db.VarChar(255)
  organizationId  String?        @map("organization_id") @db.VarChar(255)
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamp(0)
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?      @default(now()) @map("updated_at") @db.Timestamp(0)

  appointments      Appointment[]
  payments          Payment[]
  teleconsultations Teleconsultation[]

  @@index([status], map: "idx_patients_status")
  @@map("patients")
}

model Doctor {
  id              BigInt       @id @default(autoincrement())
  uuid            String       @unique(map: "uq_doctors_uuid") @db.Char(36)
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String       @map("last_name") @db.VarChar(100)
  email           String       @unique(map: "uq_doctors_email") @db.VarChar(150)
  phone           String       @unique(map: "uq_doctors_phone") @db.VarChar(30)
  password        String       @db.VarChar(255)
  specialtyId     BigInt       @map("specialty_id")
  licenseNumber   String       @unique(map: "uq_doctors_license_number") @map("license_number") @db.VarChar(100)
  bio             String?      @db.Text
  consultationFee Decimal      @default(0.00) @map("consultation_fee") @db.Decimal(12, 2)
  currency        String       @default("USD") @db.VarChar(3)
  avatar          String?      @db.VarChar(500)
  status          DoctorStatus @default(pending)
  externalRef     String?      @map("external_ref") @db.VarChar(255)
  organizationId  String?      @map("organization_id") @db.VarChar(255)
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamp(0)
  createdAt       DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?    @default(now()) @map("updated_at") @db.Timestamp(0)

  specialty         Specialty          @relation(fields: [specialtyId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_doctors_specialty")
  appointments      Appointment[]
  teleconsultations Teleconsultation[]

  @@index([specialtyId], map: "idx_doctors_specialty")
  @@index([status], map: "idx_doctors_status")
  @@map("doctors")
}

model Appointment {
  id              BigInt                   @id @default(autoincrement())
  uuid            String                   @unique(map: "uq_appointments_uuid") @db.Char(36)
  patientId       BigInt                   @map("patient_id")
  doctorId        BigInt                   @map("doctor_id")
  appointmentDate DateTime                 @map("appointment_date") @db.Date
  startTime       DateTime                 @map("start_time") @db.Time(0)
  endTime         DateTime                 @map("end_time") @db.Time(0)
  reason          String?                  @db.Text
  status          AppointmentStatus        @default(pending)
  paymentStatus   AppointmentPaymentStatus @default(unpaid) @map("payment_status")
  createdAt       DateTime?                @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?                @default(now()) @map("updated_at") @db.Timestamp(0)

  patient          Patient           @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_appointments_patient")
  doctor           Doctor            @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_appointments_doctor")
  payments         Payment[]
  teleconsultation Teleconsultation?

  @@index([patientId], map: "idx_appointments_patient")
  @@index([doctorId], map: "idx_appointments_doctor")
  @@index([appointmentDate], map: "idx_appointments_date")
  @@index([status], map: "idx_appointments_status")
  @@index([paymentStatus], map: "idx_appointments_payment_status")
  @@map("appointments")
}

model Payment {
  id                   BigInt        @id @default(autoincrement())
  uuid                 String        @unique(map: "uq_payments_uuid") @db.Char(36)
  appointmentId        BigInt        @map("appointment_id")
  patientId            BigInt        @map("patient_id")
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("USD") @db.VarChar(3)
  method               PaymentMethod
  provider             String?       @db.VarChar(100)
  transactionReference String?       @map("transaction_reference") @db.VarChar(150)
  status               PaymentStatus @default(pending)
  paidAt               DateTime?     @map("paid_at") @db.Timestamp(0)
  createdAt            DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt            DateTime?     @default(now()) @map("updated_at") @db.Timestamp(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_payments_appointment")
  patient     Patient     @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_payments_patient")

  @@index([appointmentId], map: "idx_payments_appointment")
  @@index([patientId], map: "idx_payments_patient")
  @@index([status], map: "idx_payments_status")
  @@index([transactionReference], map: "idx_payments_transaction_reference")
  @@map("payments")
}

model Teleconsultation {
  id            BigInt                 @id @default(autoincrement())
  uuid          String                 @unique(map: "uq_teleconsultations_uuid") @db.Char(36)
  appointmentId BigInt                 @unique(map: "uq_teleconsultations_appointment") @map("appointment_id")
  patientId     BigInt                 @map("patient_id")
  doctorId      BigInt                 @map("doctor_id")
  roomId        String                 @unique(map: "uq_teleconsultations_room") @map("room_id") @db.VarChar(150)
  meetingId     String?                @map("meeting_id") @db.VarChar(255)
  status        TeleconsultationStatus @default(waiting)
  startedAt     DateTime?              @map("started_at") @db.Timestamp(0)
  endedAt       DateTime?              @map("ended_at") @db.Timestamp(0)
  createdAt     DateTime?              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?              @default(now()) @map("updated_at") @db.Timestamp(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_teleconsultations_appointment")
  patient     Patient     @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_teleconsultations_patient")
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_teleconsultations_doctor")
  messages    Message[]
  calls       Call[]

  @@index([patientId], map: "idx_teleconsultations_patient")
  @@index([doctorId], map: "idx_teleconsultations_doctor")
  @@index([status], map: "idx_teleconsultations_status")
  @@map("teleconsultations")
}

model Message {
  id                 BigInt      @id @default(autoincrement())
  uuid               String      @unique(map: "uq_messages_uuid") @db.Char(36)
  teleconsultationId BigInt      @map("teleconsultation_id")
  senderType         SenderType  @map("sender_type")
  senderId           BigInt      @map("sender_id")
  type               MessageType
  content            String?     @db.Text
  audioUrl           String?     @map("audio_url") @db.VarChar(500)
  audioDuration      Int?        @map("audio_duration")
  readAt             DateTime?   @map("read_at") @db.Timestamp(0)
  createdAt          DateTime?   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?   @default(now()) @map("updated_at") @db.Timestamp(0)

  teleconsultation Teleconsultation @relation(fields: [teleconsultationId], references: [id], onUpdate: Cascade, onDelete: Cascade, map: "fk_messages_teleconsultation")

  @@index([teleconsultationId], map: "idx_messages_teleconsultation")
  @@index([senderType, senderId], map: "idx_messages_sender")
  @@index([createdAt], map: "idx_messages_created_at")
  @@map("messages")
}

model Call {
  id                 BigInt     @id @default(autoincrement())
  uuid               String     @unique(map: "uq_calls_uuid") @db.Char(36)
  teleconsultationId BigInt     @map("teleconsultation_id")
  callerType         SenderType @map("caller_type")
  callerId           BigInt     @map("caller_id")
  receiverType       SenderType @map("receiver_type")
  receiverId         BigInt     @map("receiver_id")
  type               CallType
  roomId             String     @map("room_id") @db.VarChar(150)
  status             CallStatus @default(calling)
  startedAt          DateTime?  @map("started_at") @db.Timestamp(0)
  endedAt            DateTime?  @map("ended_at") @db.Timestamp(0)
  createdAt          DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?  @default(now()) @map("updated_at") @db.Timestamp(0)

  teleconsultation Teleconsultation @relation(fields: [teleconsultationId], references: [id], onUpdate: Cascade, onDelete: Cascade, map: "fk_calls_teleconsultation")

  @@index([teleconsultationId], map: "idx_calls_teleconsultation")
  @@index([callerType, callerId], map: "idx_calls_caller")
  @@index([receiverType, receiverId], map: "idx_calls_receiver")
  @@index([status], map: "idx_calls_status")
  @@index([roomId], map: "idx_calls_room")
  @@map("calls")
}

model AuthCode {
  id          BigInt       @id @default(autoincrement())
  challengeId String       @unique(map: "uq_auth_codes_challenge_id") @map("challenge_id") @db.VarChar(255)
  email       String       @db.VarChar(150)
  userType    AuthCodeUserType @map("user_type")
  userId      BigInt       @map("user_id")
  purpose     AuthCodePurpose
  codeHash    String       @map("code_hash") @db.VarChar(255)
  expiresAt   DateTime     @map("expires_at") @db.Timestamp(0)
  lastSentAt  DateTime     @map("last_sent_at") @db.Timestamp(0)
  consumedAt  DateTime?    @map("consumed_at") @db.Timestamp(0)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([email, userType, purpose], map: "idx_auth_codes_email_type_purpose")
  @@index([expiresAt], map: "idx_auth_codes_expires_at")
  @@map("auth_codes")
}

enum PatientGender {
  male
  female
  other

  @@map("patient_gender")
}

enum PatientStatus {
  active
  blocked
  pending
}

enum DoctorStatus {
  active
  inactive
  pending
  blocked
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

enum AppointmentPaymentStatus {
  unpaid
  paid
  refunded
}

enum PaymentMethod {
  mpesa
  airtel_money
  orange_money
  card
}

enum PaymentStatus {
  pending
  processing
  successful
  failed
  cancelled
  refunded
}

enum TeleconsultationStatus {
  waiting
  active
  completed
  cancelled
}

enum SenderType {
  patient
  doctor
}

enum MessageType {
  text
  audio
}

enum CallType {
  audio
  video
}

enum CallStatus {
  calling
  accepted
  rejected
  missed
  active
  completed
  failed
}

enum AuthCodeUserType {
  patient
  doctor

  @@map("auth_code_user_type")
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  LOGIN_2FA

  @@map("auth_code_purpose")
}
